{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "collector",
  "description": "Permite somente enviar a extração da janela de coleta do Mercado Livre",
  "windows": ["collector", "collector-popup-*"],
  "local": false,
  "remote": {
    "urls": [
      "https://*.mercadolivre.com.br/*",
      "https://mercadolivre.com.br/*",
      "https://*.mercadolivre.com/*",
      "https://mercadolivre.com/*",
      "https://*.mercadolibre.com/*",
      "https://mercadolibre.com/*"
    ]
  },
  "permissions": ["core:event:allow-emit"]
}
